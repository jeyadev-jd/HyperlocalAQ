# Copy to .env or export these variables. Never commit real keys.
WAQI_API_TOKEN=
NASA_FIRMS_API_KEY=
# Optional: TomTom live traffic. Without it the traffic adjustment is switched off.
TOMTOM_API_KEY=
# Traffic mode: auto (default), tomtom, synthetic (labelled demo proxy) or none
HYPERLOCALAQ_TRAFFIC=
# Optional: path to the neighbourhood CSV (default: chennai-area.csv next to the script)
HYPERLOCALAQ_NEIGHBORHOOD_CSV=
